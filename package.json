{
  "name": "stellar-pdf",
  "version": "1.0.0",
  "description": "Stellar PDF: beautiful Linux PDF editor with form filling and redaction",
  "author": "bgrech",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:linux": "electron-builder --linux",
    "test:python": "python3 -m pytest",
    "lint:python": "python3 -m pylint python/pdf_server.py",
    "test:ui": "playwright test",
    "test:ui:report": "playwright show-report tests/ui/report"
  },
  "dependencies": {
    "pdfjs-dist": "^4.4.168",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thoughtbanger.stellarpdf",
    "productName": "Stellar PDF",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!python/**",
      "!dist/**",
      "!*.md"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office",
      "maintainer": "brian grech <87876720+BeeGrech@users.noreply.github.com>"
    }
  }
}
